\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} 创建一个测试文件}
\PYG{n+nb}{echo}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}test\PYGZdq{}}\PYG{+w}{ }\PYGZgt{}\PYG{+w}{ }test.txt

\PYG{c+c1}{\PYGZsh{} 查看初始权限}
ls\PYG{+w}{ }\PYGZhy{}l\PYG{+w}{ }test.txt

\PYG{c+c1}{\PYGZsh{} 给所有用户添加执行权限}
chmod\PYG{+w}{ }+x\PYG{+w}{ }test.txt
ls\PYG{+w}{ }\PYGZhy{}l\PYG{+w}{ }test.txt

\PYG{c+c1}{\PYGZsh{} 移除组和其他用户的写权限}
chmod\PYG{+w}{ }go\PYGZhy{}w\PYG{+w}{ }test.txt
ls\PYG{+w}{ }\PYGZhy{}l\PYG{+w}{ }test.txt
\end{MintedVerbatim}
