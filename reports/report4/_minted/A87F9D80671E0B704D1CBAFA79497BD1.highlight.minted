\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c}{\PYGZsh{} 声明伪目标，防止目录下有同名文件导致 make 误判}
\PYG{n+nf}{.PHONY}\PYG{o}{:}\PYG{+w}{ }\PYG{n}{all} \PYG{n}{clean}

\PYG{c}{\PYGZsh{} 默认目标：依赖于两个最终产物}
\PYG{n+nf}{all}\PYG{o}{:}\PYG{+w}{ }\PYG{n}{stats}.\PYG{n}{txt} \PYG{n}{report}.\PYG{n}{txt}

\PYG{c}{\PYGZsh{} stats.txt 依赖于源数据 data.csv 和脚本 stats.py}
\PYG{n+nf}{stats.txt}\PYG{o}{:}\PYG{+w}{ }\PYG{n}{data}.\PYG{n}{csv} \PYG{n}{stats}.\PYG{n}{py}
\PYG{err}{\PYGZca{}\PYGZca{}Ipython3}\PYG{+w}{ }\PYG{err}{stats.py}

\PYG{c}{\PYGZsh{} report.txt 依赖于中间产物 stats.txt、脚本 build\PYGZus{}report.py 以及模板文件 report.md}
\PYG{n+nf}{report.txt}\PYG{o}{:}\PYG{+w}{ }\PYG{n}{stats}.\PYG{n}{txt} \PYG{n}{build\PYGZus{}report}.\PYG{n}{py} \PYG{n}{report}.\PYG{n}{md}
\PYG{err}{\PYGZca{}\PYGZca{}Ipython3}\PYG{+w}{ }\PYG{err}{build\PYGZus{}report.py}

\PYG{c}{\PYGZsh{} 清理规则：只删除生成的产物，不删除源文件}
\PYG{n+nf}{clean}\PYG{o}{:}
\PYG{err}{\PYGZca{}\PYGZca{}Irm}\PYG{+w}{ }\PYG{err}{\PYGZhy{}f}\PYG{+w}{ }\PYG{err}{stats.txt}\PYG{+w}{ }\PYG{err}{report.txt}
\end{MintedVerbatim}
